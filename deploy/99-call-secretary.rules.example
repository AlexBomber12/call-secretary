# Template only: do not install until H1 proves this serial uniquely identifies
# the dedicated SIM7600 (including all its audio/tty interfaces). Never use a
# vendor-wide rule or the existing SMS modem. Reload rules, then replug only the
# dedicated modem; do not trigger/reset unrelated USB devices.
SUBSYSTEM=="tty", ATTRS{serial}=="REPLACE_WITH_UNIQUE_H1_USB_SERIAL", GROUP="call-secretary", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="sound", ATTRS{serial}=="REPLACE_WITH_UNIQUE_H1_USB_SERIAL", GROUP="call-secretary", MODE="0660"
