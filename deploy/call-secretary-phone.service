[Unit]
Description=Family call secretary - dedicated accepted SIM7600
After=network-online.target sound.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=call-secretary
Group=call-secretary
WorkingDirectory=/etc/call-secretary
ExecStart=/opt/call-secretary/current/venv/bin/call-secretary --profiles /etc/call-secretary/family.yaml --env-file /etc/call-secretary/secretary.env phone-run
Restart=on-failure
RestartSec=10
TimeoutStopSec=12
KillMode=control-group
StateDirectory=call-secretary
StateDirectoryMode=0700
UMask=0077
LimitCORE=0
MemoryMax=512M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/call-secretary
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
