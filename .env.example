# Runtime configuration template. Copy to a private .env; never commit secrets.
OPENAI_API_KEY=
REALTIME_MODEL=
REALTIME_VOICE=
TRANSCRIPTION_MODEL=gpt-transcribe
SUMMARY_MODEL=gpt-6-luna
TELEGRAM_BOT_TOKEN=
# Per-person destinations and greetings belong in the private profiles file.
PROFILES_CONFIG=./config/family.yaml
# Optional operator destination for content-free unresolved-route alerts.
ADMIN_TELEGRAM_CHAT_ID=

# Resolve the dedicated call modem's stable interfaces during hardware acceptance.
MODEM_CONTROL_DEVICE=
# Stable /dev/serial/by-id or by-path PCM interface on the same SIM7600 as the AT port.
MODEM_PCM_DEVICE=
# Legacy PortAudio path when MODEM_PCM_DEVICE is empty.
MODEM_AUDIO_DEVICE=
# Set only after recorded H1 acceptance; these never enable the service implicitly.
PHONE_H1_CONFIRMED=false
PHONE_INGRESS_ID=
# Exact unique sounddevice names; defaults to MODEM_AUDIO_DEVICE if blank.
MODEM_AUDIO_INPUT=
MODEM_AUDIO_OUTPUT=
# SIM7600 Serial PCM uses 8000. Legacy PortAudio uses the H1-verified mono PCM16 rate.
MODEM_AUDIO_RATE=
STATE_DIR=./data
REPORT_LANGUAGE=ru
GREETING_LANGUAGE=it
CALL_MAX_DURATION_SECONDS=600
AUDIO_RECORDING_ENABLED=false

# Explicit zero means no automatic expiry; blank is invalid.
TEXT_RETENTION_DAYS=0
# Shared family voice/API budget, not a per-profile allowance.
MONTHLY_API_BUDGET_EUR=50
BUDGET_TIMEZONE=Europe/Rome
# UTC review date. status warns during the last five days of the 30-day window.
BILLING_REVIEWED_ON=
# Conservative accounting policy multiplier, not a live exchange-rate quotation.
USD_TO_EUR_UPPER_BOUND=1.5
