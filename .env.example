# Proposed configuration only: no runtime implementation exists yet.
# Copy to a private runtime .env when implementing/deploying; never commit secrets.
OPENAI_API_KEY=
REALTIME_MODEL=
REALTIME_VOICE=
TELEGRAM_BOT_TOKEN=
# Per-person destinations and greetings belong in the private profiles file.
PROFILES_CONFIG=./config/family.yaml
# Optional operator destination for content-free unresolved-route alerts.
ADMIN_TELEGRAM_CHAT_ID=

# Resolve the dedicated call modem's stable interfaces during hardware acceptance.
MODEM_CONTROL_DEVICE=
MODEM_AUDIO_DEVICE=
STATE_DIR=./data
REPORT_LANGUAGE=ru
GREETING_LANGUAGE=it
CALL_MAX_DURATION_SECONDS=600
AUDIO_RECORDING_ENABLED=false

# Explicit zero means no automatic expiry; blank is invalid.
TEXT_RETENTION_DAYS=0
# Shared family voice/API budget, not a per-profile allowance.
MONTHLY_API_BUDGET_EUR=50
BUDGET_TIMEZONE=Europe/Rome
# Recheck official tariffs before live use; dates older than 30 days fail closed.
BILLING_REVIEWED_ON=
# Conservative accounting policy multiplier, not a live exchange-rate quotation.
USD_TO_EUR_UPPER_BOUND=1.5
